# Server Configuration
PORT=3000

# Forge Configuration
FORGE_PROJECT_DIR=./foundry
# FORGE_BIN=/path/to/forge           # Optional: Override forge binary path
# FOUNDRY_HOME=/path/to/home         # Optional: Override Foundry home (default: $HOME)
# FOUNDRY_DIR=/path/to/.foundry      # Optional: Override Foundry directory (default: $FOUNDRY_HOME/.foundry)
# FOUNDRY_BIN_DIR=/path/to/bin       # Optional: Override Foundry bin directory (default: $FOUNDRY_DIR/bin)

# Authentication
DAPP_API_KEYS=your-api-key-here              # Comma-separated API keys that dapps use to call /api/queue
TRACER_CALLBACK_API_KEY=your-callback-key    # API key sent with callback requests for dapp to verify
